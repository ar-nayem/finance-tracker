// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// role: "admin" | "user"
model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  role           String   @default("user")
  disabled       Boolean  @default(false)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  streams      Stream[]
  accounts     Account[]
  transactions Transaction[]
  investments  Investment[]
  transfers    Transfer[]
  documents    Document[]
}

// currency: "RMB" | "BDT"
model Stream {
  id           String        @id @default(cuid())
  name         String
  currency     String
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

// type: "bank" | "wallet" | "cash"
// role: "operating" | "spending" | "savings"
model Account {
  id           String        @id @default(cuid())
  name         String
  currency     String
  type         String
  role         String
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  investments  Investment[]
  transfersOut Transfer[]    @relation("AccountTransfersOut")
  transfersIn  Transfer[]    @relation("AccountTransfersIn")
}

// type: "income" | "expense"
model Transaction {
  id         String    @id @default(cuid())
  date       DateTime
  amount     Float
  currency   String
  type       String
  category   String?
  note       String?
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  streamId   String
  stream     Stream    @relation(fields: [streamId], references: [id])
  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
}

// Funded directly by a real account/wallet (Alipay, WeChat, bank), never by
// a job or business stream directly. Available-to-invest = that account's
// transaction balance minus what's already tied up in active investments,
// plus returns paid back to it.
// status: "active" | "exited" | "lost"
model Investment {
  id         String             @id @default(cuid())
  name       String
  amount     Float
  currency   String
  date       DateTime
  type       String?
  status     String             @default("active")
  notes      String?
  accountId  String
  account    Account            @relation(fields: [accountId], references: [id])
  returns    InvestmentReturn[]
  documentId String?            @unique
  document   Document?          @relation(fields: [documentId], references: [id])
  createdAt  DateTime           @default(now())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
}

// Money moved between two of your own accounts. Not tied to a Stream — a
// transfer isn't income/expense against any income source. Amounts are
// denormalized (fromAmount/fromCurrency, toAmount/toCurrency) the same way
// Transaction/Investment already denormalize currency.
model Transfer {
  id            String   @id @default(cuid())
  date          DateTime
  fromAccountId String
  fromAccount   Account  @relation("AccountTransfersOut", fields: [fromAccountId], references: [id])
  fromAmount    Float
  fromCurrency  String
  toAccountId   String
  toAccount     Account  @relation("AccountTransfersIn", fields: [toAccountId], references: [id])
  toAmount      Float
  toCurrency    String
  note          String?
  createdAt     DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
}

model InvestmentReturn {
  id           String     @id @default(cuid())
  date         DateTime
  amount       Float
  currency     String
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id           String   @id @default(cuid())
  date         DateTime
  fromCurrency String
  toCurrency   String
  rate         Float

  @@unique([date, fromCurrency, toCurrency])
}

// Optional file attached to a Transaction or Investment (receipts,
// calculation sheets, transition paperwork). File bytes live on disk under
// UPLOADS_DIR; this row just tracks metadata + path.
model Document {
  id          String       @id @default(cuid())
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime     @default(now())
  transaction Transaction?
  investment  Investment?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
}
