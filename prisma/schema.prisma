// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// role: "admin" | "user"
model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  role           String   @default("user")
  disabled       Boolean  @default(false)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Personal branding shown in the nav bar and on generated PDFs (invoices,
  // statements) in place of the generic "Finance Tracker" name/mark.
  // Logo stored inline as a data URL (capped small in updateBranding) rather
  // than on disk — it needs to be read synchronously in two very different
  // places (server-rendered <img> in the nav, raw bytes embedded into a
  // pdf-lib document) and is tiny enough that a UPLOADS_DIR file plus a
  // third authenticated download route would be pure overhead by comparison.
  displayName String?
  logoDataUrl String?

  // Where monthly report emails go. Nullable — most users won't have set
  // one until they visit Manage, or an admin sets it for them.
  email String?

  streams          Stream[]
  accounts         Account[]
  transactions     Transaction[]
  investments      Investment[]
  transfers        Transfer[]
  transferFeeRules TransferFeeRule[]
  documents        Document[]
  loginEvents      LoginEvent[]
  pageViews        PageView[]
}

// One row per successful login — admin-only visitor analysis. IP/user-agent
// come from request headers at the moment login() succeeds, not inferred
// later, so this only ever reflects real completed logins (never failed
// attempts, which have no authenticated user to attribute them to).
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// One row per authenticated page load (GET requests only — see proxy.ts).
// Deliberately lighter than LoginEvent (no IP/UA) since this is high-volume
// by nature; IP/browser detail matters more for login/security review than
// routine navigation.
model PageView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())
}

// currency: "RMB" | "BDT"
model Stream {
  id           String        @id @default(cuid())
  name         String
  currency     String
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

// type: "bank" | "wallet" | "cash"
// role: "operating" | "spending" | "savings"
model Account {
  id           String        @id @default(cuid())
  name         String
  currency     String
  type         String
  role         String
  createdAt    DateTime      @default(now())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  investments  Investment[]
  transfersOut Transfer[]    @relation("AccountTransfersOut")
  transfersIn  Transfer[]    @relation("AccountTransfersIn")
  feeRulesFrom TransferFeeRule[] @relation("FeeRuleFrom")
  feeRulesTo   TransferFeeRule[] @relation("FeeRuleTo")
}

// type: "income" | "expense"
model Transaction {
  id         String    @id @default(cuid())
  date       DateTime
  amount     Float
  currency   String
  type       String
  category   String?
  note       String?
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  streamId   String
  stream     Stream    @relation(fields: [streamId], references: [id])
  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
}

// Funded directly by a real account/wallet (Alipay, WeChat, bank), never by
// a job or business stream directly. Available-to-invest = that account's
// transaction balance minus what's already tied up in active investments,
// plus returns paid back to it.
// status: "active" | "exited" | "lost"
model Investment {
  id         String             @id @default(cuid())
  name       String
  amount     Float
  currency   String
  date       DateTime
  type       String?
  status     String             @default("active")
  notes      String?
  accountId  String
  account    Account            @relation(fields: [accountId], references: [id])
  returns    InvestmentReturn[]
  topUps     InvestmentTopUp[]
  documentId String?            @unique
  document   Document?          @relation(fields: [documentId], references: [id])
  createdAt  DateTime           @default(now())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
}

// Money moved between two of your own accounts. Not tied to a Stream — a
// transfer isn't income/expense against any income source. Amounts are
// denormalized (fromAmount/fromCurrency, toAmount/toCurrency) the same way
// Transaction/Investment already denormalize currency.
model Transfer {
  id            String   @id @default(cuid())
  date          DateTime
  fromAccountId String
  fromAccount   Account  @relation("AccountTransfersOut", fields: [fromAccountId], references: [id])
  fromAmount    Float
  fromCurrency  String
  toAccountId   String
  toAccount     Account  @relation("AccountTransfersIn", fields: [toAccountId], references: [id])
  toAmount      Float
  toCurrency    String
  // Cost deducted from fromAmount before crediting toAccount, in fromCurrency.
  // Populated from a matching TransferFeeRule at creation time (0 if none).
  feeAmount     Float    @default(0)
  note          String?
  createdAt     DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
}

// A standing cost the user has configured for transfers along one specific
// account -> account route (e.g. "0.1% moving RMB wallet -> BDT wallet").
// Looked up by exact (fromAccountId, toAccountId) at transfer time.
model TransferFeeRule {
  id            String   @id @default(cuid())
  fromAccountId String
  fromAccount   Account  @relation("FeeRuleFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String
  toAccount     Account  @relation("FeeRuleTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  feeType       String // "percent" | "fixed"
  feeValue      Float
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([fromAccountId, toAccountId])
}

model InvestmentReturn {
  id           String     @id @default(cuid())
  date         DateTime
  amount       Float
  currency     String
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

// Additional capital put into an already-existing Investment, on top of its
// original amount. Kept as its own log (like InvestmentReturn) rather than
// mutated onto Investment.amount, so the funding date/history of each
// contribution survives — same reasoning as returns.
model InvestmentTopUp {
  id           String     @id @default(cuid())
  date         DateTime
  amount       Float
  currency     String
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

// Singleton (always exactly one row) — admin-controlled schedule for the
// monthly report email cron (scripts/send-monthly-reports.ts). hour is
// server local time (UTC on this deployment), not per-user timezone.
// lastSentYearMonth (e.g. "2026-08") guards against double-sending since the
// cron checks in every hour, not just at the exact scheduled moment.
model ReportSchedule {
  id                String   @id @default(cuid())
  enabled           Boolean  @default(false)
  dayOfMonth        Int      @default(1)
  hour              Int      @default(8)
  lastSentYearMonth String?
  updatedAt         DateTime @updatedAt
}

model ExchangeRate {
  id           String   @id @default(cuid())
  date         DateTime
  fromCurrency String
  toCurrency   String
  rate         Float

  @@unique([date, fromCurrency, toCurrency])
}

// Optional file attached to a Transaction or Investment (receipts,
// calculation sheets, transition paperwork). File bytes live on disk under
// UPLOADS_DIR; this row just tracks metadata + path.
model Document {
  id          String       @id @default(cuid())
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime     @default(now())
  transaction Transaction?
  investment  Investment?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
}
